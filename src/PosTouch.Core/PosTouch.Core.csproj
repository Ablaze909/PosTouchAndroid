<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Libreria condivisa senza interfaccia grafica.
    Contiene tutta la logica (fiscale, dati, vendita): l'app Android la usa,
    e in futuro può usarla anche POS Touch per Windows.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>PosTouch.Core</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>
</Project>
