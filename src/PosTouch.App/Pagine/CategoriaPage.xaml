<?xml version="1.0" encoding="utf-8" ?>
<!-- Copia di CategoriaDialogTouch del PC (riquadro 780×530 bianco, angoli 16) -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PosTouch.App.Pagine.CategoriaPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F5F5F5">
    <ContentPage.Resources>
        <Style x:Key="Etichetta" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="#757575" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="Campo" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#F5F5F5" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 6" />
            <Setter Property="HeightRequest" Value="46" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,0,15" />
        </Style>
    </ContentPage.Resources>

    <Border x:Name="Riquadro" WidthRequest="780" HeightRequest="560" HorizontalOptions="Center" VerticalOptions="Center"
            BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16">
        <Grid RowDefinitions="Auto,*,Auto" Padding="30">
            <!-- titolo + interruttore ATTIVA -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,15">
                <Label x:Name="Titolo" Text="➕ NUOVA CATEGORIA" FontSize="24" FontAttributes="Bold" TextColor="#37474F" />
                <HorizontalStackLayout x:Name="PannelloAttiva" Grid.Column="1" VerticalOptions="Center" Spacing="8" IsVisible="False">
                    <Label x:Name="TestoAttiva" Text="ATTIVA" FontSize="13" FontAttributes="Bold" TextColor="#4CAF50" VerticalOptions="Center" />
                    <Switch x:Name="SwAttiva" OnColor="#4CAF50" Toggled="OnAttivaCambiata" />
                </HorizontalStackLayout>
            </Grid>

            <ScrollView Grid.Row="1">
            <Grid ColumnDefinitions="*,25,*">
                <!-- sinistra -->
                <VerticalStackLayout>
                    <Label Text="Icona (opzionale) e Nome *" Style="{StaticResource Etichetta}" />
                    <Grid ColumnDefinitions="70,8,*" Margin="0,0,0,15">
                        <Border BackgroundColor="#F5F5F5" StrokeThickness="0" StrokeShape="RoundRectangle 6" HeightRequest="46">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnIcona" /></Border.GestureRecognizers>
                            <Label x:Name="TestoIcona" Text="—" FontSize="24" TextColor="#BDBDBD" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Campo}" Margin="0">
                            <Entry x:Name="CampoNome" FontSize="15" MaxLength="30" TextTransform="Uppercase" BackgroundColor="Transparent" TextChanged="OnAnteprima" />
                        </Border>
                    </Grid>

                    <Label Text="Reparto Fiscale (RT) *" Style="{StaticResource Etichetta}" />
                    <Border Style="{StaticResource Campo}">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnReparto" /></Border.GestureRecognizers>
                        <Label x:Name="TestoReparto" Text="Tocca per scegliere" FontSize="15" TextColor="#BDBDBD" VerticalOptions="Center" />
                    </Border>

                    <Label Text="Aliquota IVA (%) *" Style="{StaticResource Etichetta}" />
                    <Border Style="{StaticResource Campo}">
                        <Picker x:Name="SceltaIva" FontSize="15" BackgroundColor="Transparent">
                            <Picker.Items>
                                <x:String>4%</x:String>
                                <x:String>5%</x:String>
                                <x:String>10%</x:String>
                                <x:String>22%</x:String>
                            </Picker.Items>
                        </Picker>
                    </Border>
                </VerticalStackLayout>

                <!-- destra -->
                <VerticalStackLayout Grid.Column="2">
                    <Label Text="Colore Sfondo" Style="{StaticResource Etichetta}" />
                    <Grid ColumnDefinitions="*,60" ColumnSpacing="8" Margin="0,0,0,12">
                        <Border Style="{StaticResource Campo}" Margin="0">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnColore" /></Border.GestureRecognizers>
                            <Label x:Name="TestoColore" FontSize="15" VerticalOptions="Center" />
                        </Border>
                        <Border x:Name="AnteprimaColore" Grid.Column="1" StrokeThickness="1" Stroke="#E0E0E0" StrokeShape="RoundRectangle 6">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnColore" /></Border.GestureRecognizers>
                        </Border>
                    </Grid>

                    <Label Text="Colore Testo" Style="{StaticResource Etichetta}" />
                    <Grid ColumnDefinitions="*,60" ColumnSpacing="8" Margin="0,0,0,12">
                        <Border Style="{StaticResource Campo}" Margin="0">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnColoreTesto" /></Border.GestureRecognizers>
                            <Label x:Name="TestoColoreTesto" FontSize="15" VerticalOptions="Center" />
                        </Border>
                        <Border x:Name="AnteprimaColoreTesto" Grid.Column="1" StrokeThickness="1" Stroke="#E0E0E0" StrokeShape="RoundRectangle 6">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnColoreTesto" /></Border.GestureRecognizers>
                        </Border>
                    </Grid>

                    <Label Text="Anteprima Tasto POS" Style="{StaticResource Etichetta}" />
                    <Border x:Name="AnteprimaTasto" HeightRequest="55" StrokeThickness="0" StrokeShape="RoundRectangle 14" Margin="0,0,0,10">
                        <Label x:Name="AnteprimaNome" Text="CATEGORIA" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" Margin="6" />
                    </Border>

                    <Border BackgroundColor="#E3F2FD" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10">
                        <Label FontSize="11" TextColor="#1976D2">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="ℹ️ REPARTO FISCALE" FontAttributes="Bold" />
                                    <Span Text="&#10;Necessario per RT. Reparto da 1 a 99." />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Border>
                </VerticalStackLayout>
            </Grid>
            </ScrollView>

            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,140,10,140" Margin="0,15,0,0">
                <Button x:Name="BtnElimina" Text="🗑️ ELIMINA" WidthRequest="140" HeightRequest="50" FontSize="16" BackgroundColor="#F44336"
                        CornerRadius="8" IsVisible="False" Clicked="OnElimina" />
                <Button Grid.Column="2" Text="❌ ANNULLA" HeightRequest="50" FontSize="16" BackgroundColor="#9E9E9E" CornerRadius="8" Clicked="OnAnnulla" />
                <Button Grid.Column="4" Text="✓ SALVA" HeightRequest="50" FontSize="16" BackgroundColor="#4CAF50" CornerRadius="8" Clicked="OnSalva" />
            </Grid>
        </Grid>
    </Border>
</ContentPage>
