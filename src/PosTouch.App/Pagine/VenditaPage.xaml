<?xml version="1.0" encoding="utf-8" ?>
<!--
    Schermata vendita: stesso layout di MainWindow.xaml (POS Touch Windows).
    Colonne: categorie 120 | articoli * | scontrino + tastiera 320.
    Righe:   contenuto * | barra pagamenti 58 (sotto categorie e articoli).
-->
<ctl:PaginaPos xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctl="clr-namespace:PosTouch.App.Controlli"
             xmlns:m="clr-namespace:PosTouch.Core.Modelli;assembly=PosTouch.Core"
             xmlns:conv="clr-namespace:PosTouch.App.Convertitori"
             x:Class="PosTouch.App.Pagine.VenditaPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="White">

    <ctl:PaginaPos.Resources>
        <conv:ColoreConverter x:Key="Colore" />
        <!-- carattere delle righe dello scontrino: cresce sugli schermi grandi (vedi OnSizeAllocated) -->
        <x:Double x:Key="FontRiga">13</x:Double>
        <x:Double x:Key="FontRigaPiccola">12</x:Double>
        <!-- righe dello scontrino: un modello per tipo (vedi SelettoreRiga) -->
        <DataTemplate x:Key="RigaProdotto" x:DataType="m:RigaScontrino">
            <Grid Padding="4,6" MinimumHeightRequest="32" ColumnDefinitions="28,*,74"
                  BackgroundColor="{Binding ColoreSfondo, Converter={StaticResource Colore}, ConverterParameter='#FFFFFF'}">
                <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnRigaToccata" /></Grid.GestureRecognizers>
                <Label Text="{Binding QuantitaDisplay}" FontSize="{DynamicResource FontRiga}" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" Margin="4,0,3,0" VerticalOptions="Center">
                    <Label Text="{Binding Descrizione}" FontSize="{DynamicResource FontRiga}" FontAttributes="Bold" LineBreakMode="WordWrap" />
                    <!-- articoli a peso: "0,385 Kg × € 12,00/Kg" (la colonna quantità mostra solo ⚖) -->
                    <Label Text="{Binding DettaglioPeso}" FontSize="{DynamicResource FontRigaPiccola}" TextColor="#455A64" IsVisible="{Binding IsAPeso}" />
                </VerticalStackLayout>
                <Label Grid.Column="2" Text="{Binding ImportoDisplay}" FontSize="{DynamicResource FontRiga}" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center" />
                    <BoxView WidthRequest="3" Color="#43A047" HorizontalOptions="Start" Margin="-4,-6,0,-6" IsVisible="{Binding Comandata}" />
                <BoxView Grid.ColumnSpan="3" WidthRequest="5" Color="#1565C0" HorizontalOptions="End" Margin="0,-6,-4,-6" IsVisible="{Binding Selezionata}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="RigaSconto" x:DataType="m:RigaScontrino">
            <Grid Padding="4,6" MinimumHeightRequest="32" ColumnDefinitions="28,*,74"
                  BackgroundColor="{Binding ColoreSfondo, Converter={StaticResource Colore}, ConverterParameter='#FFFFFF'}">
                <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnRigaToccata" /></Grid.GestureRecognizers>
                <Label Text="🎯" FontSize="{DynamicResource FontRigaPiccola}" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding Descrizione}" FontSize="{DynamicResource FontRiga}" FontAttributes="Bold" TextColor="#D84315" Margin="4,0,3,0" VerticalOptions="Center" />
                <Label Grid.Column="2" Text="{Binding ImportoDisplay}" FontSize="{DynamicResource FontRiga}" FontAttributes="Bold" TextColor="#D84315" HorizontalTextAlignment="End" VerticalOptions="Center" />
                <BoxView Grid.ColumnSpan="3" WidthRequest="5" Color="#1565C0" HorizontalOptions="End" Margin="0,-6,-4,-6" IsVisible="{Binding Selezionata}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="RigaSubtotale" x:DataType="m:RigaScontrino">
            <Grid Padding="4,6" MinimumHeightRequest="32" ColumnDefinitions="28,*,74"
                  BackgroundColor="{Binding ColoreSfondo, Converter={StaticResource Colore}, ConverterParameter='#FFFFFF'}">
                <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnRigaToccata" /></Grid.GestureRecognizers>
                <Label Grid.Column="1" Text="{Binding Descrizione}" FontSize="{DynamicResource FontRiga}" FontAttributes="Bold" HorizontalTextAlignment="End" Margin="0,0,10,0" VerticalOptions="Center" />
                <Label Grid.Column="2" Text="{Binding ImportoDisplay}" FontSize="{DynamicResource FontRiga}" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center" />
                <BoxView Grid.ColumnSpan="3" WidthRequest="5" Color="#1565C0" HorizontalOptions="End" Margin="0,-6,-4,-6" IsVisible="{Binding Selezionata}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="RigaSeparatore" x:DataType="m:RigaScontrino">
            <Grid Padding="4,6" MinimumHeightRequest="32" ColumnDefinitions="28,*,74"
                  BackgroundColor="{Binding ColoreSfondo, Converter={StaticResource Colore}, ConverterParameter='#FFFFFF'}">
                <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnRigaToccata" /></Grid.GestureRecognizers>
                <Label Grid.ColumnSpan="3" Text="{Binding Descrizione}" FontSize="{DynamicResource FontRigaPiccola}" TextColor="#78909C" HorizontalTextAlignment="Center" VerticalOptions="Center" LineBreakMode="NoWrap" />
                <BoxView Grid.ColumnSpan="3" WidthRequest="5" Color="#1565C0" HorizontalOptions="End" Margin="0,-6,-4,-6" IsVisible="{Binding Selezionata}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="RigaVariante" x:DataType="m:RigaScontrino">
            <Grid Padding="4,6" MinimumHeightRequest="32" ColumnDefinitions="28,*,74"
                  BackgroundColor="{Binding ColoreSfondo, Converter={StaticResource Colore}, ConverterParameter='#FFFFFF'}">
                <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnRigaToccata" /></Grid.GestureRecognizers>
                <Label Grid.Column="1" Text="{Binding Descrizione}" FontSize="{DynamicResource FontRigaPiccola}" FontAttributes="Italic" TextColor="#6D4C41" Margin="14,0,3,0" VerticalOptions="Center" />
                <Label Grid.Column="2" Text="{Binding VarianteDisplay}" FontSize="{DynamicResource FontRigaPiccola}" TextColor="#6D4C41" HorizontalTextAlignment="End" VerticalOptions="Center" />
                <BoxView Grid.ColumnSpan="3" WidthRequest="5" Color="#1565C0" HorizontalOptions="End" Margin="0,-6,-4,-6" IsVisible="{Binding Selezionata}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="RigaGusto" x:DataType="m:RigaScontrino">
            <Grid Padding="4,6" MinimumHeightRequest="32" ColumnDefinitions="28,*,74"
                  BackgroundColor="{Binding ColoreSfondo, Converter={StaticResource Colore}, ConverterParameter='#FFFFFF'}">
                <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnRigaToccata" /></Grid.GestureRecognizers>
                <Label Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Descrizione}" FontSize="{DynamicResource FontRigaPiccola}" TextColor="#E65100" Margin="4,0,3,0" VerticalOptions="Center" />
                <BoxView Grid.ColumnSpan="3" WidthRequest="5" Color="#1565C0" HorizontalOptions="End" Margin="0,-6,-4,-6" IsVisible="{Binding Selezionata}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="RigaPortata" x:DataType="m:RigaScontrino">
            <Grid Padding="4,6" MinimumHeightRequest="32" ColumnDefinitions="28,*,74"
                  BackgroundColor="{Binding ColoreSfondo, Converter={StaticResource Colore}, ConverterParameter='#FFFFFF'}">
                <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnRigaToccata" /></Grid.GestureRecognizers>
                <Label Grid.ColumnSpan="3" Text="{Binding Descrizione}" FontSize="{DynamicResource FontRiga}" FontAttributes="Bold" TextColor="White" BackgroundColor="#546E7A" Padding="0,3" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                <BoxView Grid.ColumnSpan="3" WidthRequest="5" Color="#1565C0" HorizontalOptions="End" Margin="0,-6,-4,-6" IsVisible="{Binding Selezionata}" />
            </Grid>
        </DataTemplate>
        <ctl:SelettoreRiga x:Key="SelettoreRighe" Prodotto="{StaticResource RigaProdotto}" Sconto="{StaticResource RigaSconto}"
                           Subtotale="{StaticResource RigaSubtotale}" Separatore="{StaticResource RigaSeparatore}" Variante="{StaticResource RigaVariante}"
                           Gusto="{StaticResource RigaGusto}" Portata="{StaticResource RigaPortata}" />

        <!-- ModernButton del PC: tasti tastiera bianchi, piatti, testo nero -->
        <Style x:Key="TastoNum" TargetType="Button">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="TextColor" Value="#111111" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1" />
        </Style>
        <Style x:Key="TastoScuro" TargetType="Button">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="TastoToolbar" TargetType="Button">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="MinimumHeightRequest" Value="44" />
            <Setter Property="Margin" Value="3,0" />
        </Style>
    </ctl:PaginaPos.Resources>

    <Grid x:Name="Radice" RowDefinitions="Auto,*,58" ColumnDefinitions="120,*,320">

        <!-- ═════════ BANDA "DOVE SONO": BANCO / TAVOLO / CONTO, colore della sala ═════════ -->
        <Grid x:Name="BandaPosto" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HeightRequest="40" Padding="14,0"
              BackgroundColor="#37474F" ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Label x:Name="BandaTitolo" Text="🧾 BANCO" FontSize="18" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"
                   LineBreakMode="TailTruncation" />
            <Label x:Name="BandaDettaglio" Grid.Column="1" Text="Vendita diretta" FontSize="14" TextColor="White" VerticalOptions="Center" HorizontalTextAlignment="End"
                   LineBreakMode="TailTruncation" MaxLines="1" />
        </Grid>
        <!-- salvataggio automatico del tavolo non riuscito: resta finché il salvataggio dopo non va -->
        <Label x:Name="AvvisoSalvataggio" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="⚠️ TAVOLO NON SALVATO" FontSize="14" FontAttributes="Bold"
               TextColor="White" BackgroundColor="#C62828" Padding="10,0" HorizontalOptions="Center" VerticalOptions="Fill" VerticalTextAlignment="Center"
               IsVisible="False" InputTransparent="True" />

        <!-- ═════════ COLONNA SINISTRA: 🚪 → categorie → ▲▼ → 🏠 ═════════ -->
        <Grid Grid.Row="1" Grid.Column="0" BackgroundColor="#FAFAFA" Padding="3" RowDefinitions="46,*,42,50">
            <Button x:Name="BtnEsci" Grid.Row="0" Text="🚪" FontSize="22" BackgroundColor="#B71C1C" Style="{StaticResource TastoScuro}"
                    Margin="0,0,0,2" Clicked="OnEsci" />

            <ScrollView x:Name="ScrollCategorie" Grid.Row="1" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout x:Name="ListaCategorie" Spacing="1" Padding="0,2" />
            </ScrollView>

            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="2" Padding="0,2">
                <Button Text="▲" FontSize="22" BackgroundColor="#37474F" Style="{StaticResource TastoScuro}" Clicked="OnCategorieSu" />
                <Button Grid.Column="1" Text="▼" FontSize="22" BackgroundColor="#37474F" Style="{StaticResource TastoScuro}" Clicked="OnCategorieGiu" />
            </Grid>

            <Button Grid.Row="3" Text="🏠" FontSize="20" BackgroundColor="#F5F5F5" TextColor="#111111"
                    BorderColor="#DDDDDD" BorderWidth="1" CornerRadius="0" Clicked="OnPreferiti" />
        </Grid>
        <BoxView Grid.Row="1" Grid.Column="0" WidthRequest="1" Color="#E5E5E5" HorizontalOptions="End" />

        <!-- ═════════ COLONNA CENTRO: toolbar + articoli ═════════ -->
        <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="50,*">
            <Grid BackgroundColor="#FAFAFA">
                <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                    <Button x:Name="BtnSale" Text="🍽️ SALE" FontSize="13" FontAttributes="Bold" Padding="12,0" BackgroundColor="#00897B"
                            Style="{StaticResource TastoToolbar}" Clicked="OnSale" IsVisible="False" />
                    <Button x:Name="BtnStrumenti" Text="🔧" WidthRequest="46" BackgroundColor="#555555" Style="{StaticResource TastoToolbar}" Clicked="OnStrumenti" />
                    <Button x:Name="BtnModifica" Text="✏️" WidthRequest="46" BackgroundColor="#757575" Style="{StaticResource TastoToolbar}" Clicked="OnModifica" />
                    <Button x:Name="BtnFunzioniCassa" Text="💰 FUNZIONI CASSA" FontSize="13" FontAttributes="Bold" Padding="12,0" BackgroundColor="#555555"
                            Style="{StaticResource TastoToolbar}" Clicked="OnFunzioniCassa" />
                    <!-- operatore del turno (gestione operatori): sospendi, chiudi turno, riepilogo -->
                    <Button x:Name="BtnOperatore" Text="👤" FontSize="13" FontAttributes="Bold" Padding="12,0" BackgroundColor="#4527A0"
                            Style="{StaticResource TastoToolbar}" Clicked="OnOperatore" IsVisible="False" />
                </HorizontalStackLayout>
                <BoxView HeightRequest="1" Color="#E5E5E5" VerticalOptions="End" />
            </Grid>

            <ScrollView x:Name="ScrollArticoli" Grid.Row="1" Margin="2">
                <FlexLayout x:Name="GrigliaArticoli" Wrap="Wrap" AlignContent="Start" AlignItems="Start" />
            </ScrollView>
            <Label x:Name="MessaggioVuoto" Grid.Row="1" HorizontalTextAlignment="Center" VerticalOptions="Center"
                   TextColor="#999999" FontSize="16" Margin="30" IsVisible="False" InputTransparent="True" />

            <!-- Combinazione in corso (bannerCombinazione del PC) -->
            <Grid x:Name="BannerCombinazione" Grid.Row="1" VerticalOptions="End" BackgroundColor="#E65100" Padding="12,8"
                  ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="False">
                <Label x:Name="TestoCombinazione" FontSize="15" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" LineBreakMode="WordWrap" />
                <Button Grid.Column="1" Text="✅ CHIUDI" FontSize="15" FontAttributes="Bold" Padding="14,0" BackgroundColor="#2E7D32" HeightRequest="50" CornerRadius="6" Clicked="OnChiudiCombinazione" />
                <Button Grid.Column="2" Text="❌ ANNULLA" FontSize="15" FontAttributes="Bold" Padding="14,0" BackgroundColor="#B71C1C" HeightRequest="50" CornerRadius="6" Clicked="OnAnnullaCombinazione" />
            </Grid>
        </Grid>

        <!-- ═════════ COLONNA DESTRA: scontrino + tastiera (righe 0 e 1) ═════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" BackgroundColor="White" RowDefinitions="Auto,*,Auto,Auto,Auto">

            <!-- Intestazione nera: tocco = espandi/chiudi lista (come sul PC) -->
            <Grid Grid.Row="0" BackgroundColor="#111111" Padding="10,8" ColumnDefinitions="*,Auto">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnIntestazioneScontrino" />
                </Grid.GestureRecognizers>
                <Label x:Name="TitoloScontrino" Text="📋 SCONTRINO" FontSize="14" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"
                       LineBreakMode="TailTruncation" />
                <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="8">
                    <Label x:Name="Orologio" Text="00:00:00" FontSize="14" FontAttributes="Bold" FontFamily="monospace" TextColor="White" />
                    <Label x:Name="Data" Text="01/01/2026" FontSize="11" TextColor="White" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>

            <!-- Lista: si scorre col dito (niente frecce, coprivano 2 righe su 8"); barra di scorrimento sempre visibile
                 e "N righe" nella barra nera quando non stanno tutte a video -->
            <Grid Grid.Row="1">
                <CollectionView x:Name="ListaRighe" SelectionMode="None" Scrolled="OnListaScrolled" ItemTemplate="{StaticResource SelettoreRighe}"
                                VerticalScrollBarVisibility="Always"
                                ItemSizingStrategy="MeasureAllItems">
                </CollectionView>

            </Grid>

            <!-- Display + pezzi + totale: tocco = calcolo resto -->
            <!-- riga 1: posto a sinistra, quello che si digita a destra (riquadro bianco) · riga 2: pezzi e TOTALE sempre liberi -->
            <!-- totale sempre nero su chiaro (come il PC): il colore della sala è la striscia a sinistra -->
            <Grid x:Name="RiquadroTotale" Grid.Row="2" BackgroundColor="#F5F5F5" Padding="14,6,10,8" Margin="4,4,4,0"
                  RowDefinitions="Auto,Auto">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTotaleToccato" />
                </Grid.GestureRecognizers>
                <BoxView x:Name="StrisciaPosto" Grid.RowSpan="2" WidthRequest="6" Color="#37474F" HorizontalOptions="Start" Margin="-14,-6,0,-8" />
                <!-- due griglie separate: un posto lungo ("TAVOLO 101 · TERRAZZA") non deve allargare la colonna del TOTALE -->
                <Grid x:Name="RigaPosto" ColumnDefinitions="*,Auto" ColumnSpacing="8" HeightRequest="30">
                    <Label x:Name="TotalePosto" FontSize="12" FontAttributes="Bold" TextColor="#37474F" VerticalOptions="Center" HorizontalOptions="Start"
                           LineBreakMode="TailTruncation" MaxLines="1" />
                    <!-- RESTO dopo un incasso in contanti: resta finché non si batte l'articolo dopo -->
                    <Grid x:Name="BarraResto" Grid.ColumnSpan="2" BackgroundColor="#FF9800" Padding="8,0" IsVisible="False">
                        <Label Text="RESTO" FontSize="15" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                        <Label x:Name="EtichettaResto" Text="€ 0,00" FontSize="20" FontAttributes="Bold" TextColor="White"
                               HorizontalOptions="End" VerticalOptions="Center" />
                    </Grid>
                    <Label x:Name="DisplayTastierino" Grid.Column="1" BackgroundColor="White" Padding="8,2" IsVisible="False" FontSize="16" FontAttributes="Bold"
                           TextColor="#666666" HorizontalOptions="End" VerticalOptions="Center" LineBreakMode="NoWrap" />
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label x:Name="EtichettaPezzi" Text="0 pz" FontSize="13" FontAttributes="Bold" TextColor="#999999"
                           HorizontalOptions="Start" VerticalOptions="Center" LineBreakMode="NoWrap" />
                    <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center">
                        <Label x:Name="EtichettaTotaleScritta" Text="TOTALE:" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" Margin="0,0,6,0" />
                        <Label x:Name="EtichettaTotale" Text="€ 0,00" FontSize="24" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>
            </Grid>


            <!-- Tastiera 4x4 + sconti + quantità -->
            <Grid Grid.Row="4" Margin="4,4,4,4" RowDefinitions="Auto,Auto,Auto,Auto">
                <Grid x:Name="TastieraNumerica" BackgroundColor="#E5E5E5" RowDefinitions="60,60,60,60" ColumnDefinitions="*,*,*,*">
                    <Button Text="7" Style="{StaticResource TastoNum}" Clicked="OnCifra" />
                    <Button Text="8" Grid.Column="1" Style="{StaticResource TastoNum}" Clicked="OnCifra" />
                    <Button Text="9" Grid.Column="2" Style="{StaticResource TastoNum}" Clicked="OnCifra" />
                    <Button Text="C" Grid.Column="3" Style="{StaticResource TastoNum}" BackgroundColor="#F44336" TextColor="White" Clicked="OnCancella" />
                    <Button Text="4" Grid.Row="1" Style="{StaticResource TastoNum}" Clicked="OnCifra" />
                    <Button Text="5" Grid.Row="1" Grid.Column="1" Style="{StaticResource TastoNum}" Clicked="OnCifra" />
                    <Button Text="6" Grid.Row="1" Grid.Column="2" Style="{StaticResource TastoNum}" Clicked="OnCifra" />
                    <Button Text="X" Grid.Row="1" Grid.Column="3" Style="{StaticResource TastoNum}" BackgroundColor="#FF9800" TextColor="White" Clicked="OnPer" />
                    <Button Text="1" Grid.Row="2" Style="{StaticResource TastoNum}" Clicked="OnCifra" />
                    <Button Text="2" Grid.Row="2" Grid.Column="1" Style="{StaticResource TastoNum}" Clicked="OnCifra" />
                    <Button Text="3" Grid.Row="2" Grid.Column="2" Style="{StaticResource TastoNum}" Clicked="OnCifra" />
                    <Button Text="€" Grid.Row="2" Grid.Column="3" Grid.RowSpan="2" Style="{StaticResource TastoNum}"
                            BackgroundColor="#4CAF50" TextColor="White" FontSize="36" Clicked="OnEuro" />
                    <Button Text="0" Grid.Row="3" Style="{StaticResource TastoNum}" Clicked="OnCifra" />
                    <Button Text="00" Grid.Row="3" Grid.Column="1" Style="{StaticResource TastoNum}" FontSize="22" Clicked="OnCifra" />
                    <Button Text="," Grid.Row="3" Grid.Column="2" Style="{StaticResource TastoNum}" FontSize="32" Clicked="OnCifra" />
                </Grid>

                <Grid x:Name="RigaSconti" Grid.Row="1" HeightRequest="44" Margin="0,10,0,0" ColumnDefinitions="*,*,1.2*" ColumnSpacing="6">
                    <Button x:Name="BtnScontoValore" Text="€ SCONTO" FontSize="12" BackgroundColor="#555555" Style="{StaticResource TastoScuro}" Clicked="OnScontoValore" />
                    <Button x:Name="BtnScontoPerc" Grid.Column="1" Text="% SCONTO" FontSize="12" BackgroundColor="#555555" Style="{StaticResource TastoScuro}" Clicked="OnScontoPercentuale" />
                    <Button x:Name="BtnAnnulla" Grid.Column="2" Text="🗑️ ANNULLA" FontSize="15" BackgroundColor="#F44336" Style="{StaticResource TastoScuro}" Clicked="OnAnnulla" />
                </Grid>

                <!-- ＋ ﹣ VAR＋ VAR﹣ (gridRigaVarianti del PC) e, al tavolo, 🔀 SPOSTA 🔗 UNISCI -->
                <Grid x:Name="RigaQuantita" Grid.Row="2" HeightRequest="42" Margin="0,4,0,0" ColumnDefinitions="*,*,*,*,Auto,Auto" ColumnSpacing="4">
                    <Button Text="＋" FontSize="16" BackgroundColor="#333333" Style="{StaticResource TastoScuro}" Clicked="OnPiu" />
                    <Button Grid.Column="1" Text="﹣" FontSize="16" BackgroundColor="#333333" Style="{StaticResource TastoScuro}" Clicked="OnMeno" />
                    <Button Grid.Column="2" Text="VAR ＋" FontSize="12" BackgroundColor="#E65100" Style="{StaticResource TastoScuro}" Clicked="OnVariantePiu" />
                    <Button Grid.Column="3" Text="VAR ﹣" FontSize="12" BackgroundColor="#BF360C" Style="{StaticResource TastoScuro}" Clicked="OnVarianteMeno" />
                    <Button x:Name="BtnSposta" Grid.Column="4" Text="🔀" FontSize="16" WidthRequest="44" BackgroundColor="#5E35B1" Style="{StaticResource TastoScuro}" Clicked="OnSposta" IsVisible="False" />
                    <Button x:Name="BtnUnisci" Grid.Column="5" Text="🔗" FontSize="16" WidthRequest="44" BackgroundColor="#00838F" Style="{StaticResource TastoScuro}" Clicked="OnUnisci" IsVisible="False" />
                </Grid>

                <!-- Lista espansa: la tastiera (con C) è nascosta, quindi qui c'è il tasto per cancellare le righe selezionate -->
                <Grid x:Name="BarraListaEspansa" Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="4" Margin="0,4,0,0" IsVisible="False">
                    <Button Text="🗑️ CANCELLA RIGHE" FontSize="14" BackgroundColor="#F44336" HeightRequest="48" CornerRadius="0" Clicked="OnCancellaRigheEspanso" />
                    <Button Grid.Column="1" Text="▲ CHIUDI LISTA" FontSize="14" BackgroundColor="#607D8B" HeightRequest="48" CornerRadius="0" Clicked="OnChiudiLista" />
                </Grid>
            </Grid>

            <BoxView Grid.RowSpan="5" WidthRequest="1" Color="#E5E5E5" HorizontalOptions="Start" InputTransparent="True" />
        </Grid>

        <!-- ═════════ BARRA INFERIORE: CASSA, CASSETTO, BARCODE, reparti ═════════ -->
        <Grid x:Name="BarraInferiore" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="6,0,6,0" ColumnDefinitions="*,*,*,*,*">
            <Button Grid.ColumnSpan="2" Text="💰 CASSA" FontSize="18" BackgroundColor="#388E3C" Style="{StaticResource TastoScuro}" Margin="2" Clicked="OnCassa" />
            <Button x:Name="BtnConto" Grid.Column="2" Text="📄 CONTO" FontSize="18" BackgroundColor="#9C27B0" Style="{StaticResource TastoScuro}" Margin="2" Clicked="OnConto" />
            <Button Grid.Column="3" Text="📂 CASSETTO" FontSize="18" BackgroundColor="#FF9800" Style="{StaticResource TastoScuro}" Margin="2" Clicked="OnCassetto" />
            <Button Grid.Column="4" Text="🔍 BARCODE" FontSize="18" BackgroundColor="#795548" Style="{StaticResource TastoScuro}" Margin="2" Clicked="OnBarcode" />
        </Grid>

        <!-- ═════════ BARRA TAVOLO (come VenditaContoClienteDialog del PC) ═════════ -->
        <Grid x:Name="BarraTavolo" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="6,0,6,0" IsVisible="False"
              ColumnDefinitions="*,*,*,*,*,*,*,*">
            <Button Grid.ColumnSpan="2" Text="💰 CASSA" FontSize="16" BackgroundColor="#388E3C" Style="{StaticResource TastoScuro}" Margin="2" Clicked="OnCassa" />
            <Button x:Name="BtnContoTavolo" Grid.Column="2" Text="📄 CONTO" FontSize="14" BackgroundColor="#9C27B0" Style="{StaticResource TastoScuro}" Margin="2" Clicked="OnConto" />
            <Button x:Name="BtnPreconto" Grid.Column="3" Text="📋 PRECONTO" FontSize="13" BackgroundColor="#FDD835" TextColor="#333333" Style="{StaticResource TastoScuro}" Margin="2" Clicked="OnPreconto" />
            <Button Grid.Column="4" Text="🚫 NO STAMPA" FontSize="13" BackgroundColor="#E65100" Style="{StaticResource TastoScuro}" Margin="2" Clicked="OnNoStampa" />
            <Button Grid.Column="5" Text="💾 SALVA" FontSize="13" BackgroundColor="#757575" Style="{StaticResource TastoScuro}" Margin="2" Clicked="OnAnnullaTavolo" />
            <Button x:Name="BtnFunzioniPortate" Grid.Column="6" Text="📑 FUNZIONI" FontSize="13" BackgroundColor="#546E7A" Style="{StaticResource TastoScuro}" Margin="2" Clicked="OnFunzioniPortate" />
            <Button x:Name="BtnAvanza" Grid.Column="7" Text="⏩ AVANZA" FontSize="13" BackgroundColor="#1565C0" Style="{StaticResource TastoScuro}" Margin="2" Clicked="OnAvanza" />
        </Grid>

        <!-- ═════════ MODALITÀ MODIFICA: scontrino, tastiera e barra inferiore bloccati ═════════ -->
        <Grid x:Name="VeloScontrino" Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" BackgroundColor="#B3263238" IsVisible="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer />
            </Grid.GestureRecognizers>
            <VerticalStackLayout VerticalOptions="Center" Spacing="10" Padding="20">
                <Label Text="🔒" FontSize="48" HorizontalOptions="Center" />
                <Label Text="VENDITA BLOCCATA" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                <Label Text="Modalità modifica attiva:&#10;tocca un articolo per modificarlo.&#10;&#10;Premi ✏️ per tornare alla vendita."
                       FontSize="16" TextColor="White" HorizontalTextAlignment="Center" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
        <Grid x:Name="VeloBarra" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="Transparent" IsVisible="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer />
            </Grid.GestureRecognizers>
        </Grid>

        <!-- ═════════ OVERLAY MODALITÀ MODIFICA ═════════ -->
        <Grid x:Name="OverlayModifica" Grid.RowSpan="3" Grid.ColumnSpan="3" BackgroundColor="#1AFF9800"
              InputTransparent="True" CascadeInputTransparent="True" IsVisible="False">
            <Grid BackgroundColor="#FF9800" HeightRequest="60" VerticalOptions="End" Margin="10,0,10,10" Padding="20,0">
                <Label Text="✏️ MODALITÀ MODIFICA ATTIVA" FontSize="22" FontAttributes="Bold"
                       TextColor="White" VerticalOptions="Center" />
            </Grid>
        </Grid>

        <!-- ═════════ POPUP CASSA ═════════ -->
        <Grid x:Name="OverlayPagamento" Grid.RowSpan="3" Grid.ColumnSpan="3" IsVisible="False">
            <BoxView Color="#99000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnChiudiPagamento" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border BackgroundColor="White" StrokeThickness="0" WidthRequest="420" HeightRequest="274"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <Border.GestureRecognizers><TapGestureRecognizer /></Border.GestureRecognizers>
                <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                <Grid RowDefinitions="50,*,58">
                    <Grid BackgroundColor="#388E3C">
                        <Label Text="💰  SCEGLI METODO DI PAGAMENTO" TextColor="White" FontSize="15" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="20,16,20,8" ColumnDefinitions="*,16,*">
                        <Button Text="💵&#10;CONTANTI" BackgroundColor="#4CAF50" FontSize="16" CornerRadius="4" Clicked="OnContanti" />
                        <Button Grid.Column="2" Text="💳&#10;PAG. ELETTRONICO" BackgroundColor="#1976D2" FontSize="16" CornerRadius="4" Clicked="OnCarta" />
                    </Grid>
                    <Button Grid.Row="2" Text="ANNULLA" Margin="20,0,20,10" MinimumHeightRequest="46" BackgroundColor="#9E9E9E" TextColor="White"
                            FontSize="15" FontAttributes="Bold" CornerRadius="4" Clicked="OnChiudiPagamento" />
                </Grid>
            </Border>
        </Grid>

        <!-- ═════════ ATTESA durante la stampa ═════════ -->
        <Grid x:Name="Attesa" Grid.RowSpan="3" Grid.ColumnSpan="3" IsVisible="False" BackgroundColor="#99000000">
            <!-- riconoscitore vuoto: su Android senza di esso i tocchi passano ai tasti sotto durante l'emissione -->
            <Grid.GestureRecognizers><TapGestureRecognizer /></Grid.GestureRecognizers>
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="True" Color="White" WidthRequest="60" HeightRequest="60" />
                <Label x:Name="TestoAttesa" Text="Stampa in corso..." TextColor="White" FontSize="20" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ctl:PaginaPos>
