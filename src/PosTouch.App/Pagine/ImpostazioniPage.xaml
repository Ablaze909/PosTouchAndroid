<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PosTouch.App.Pagine.ImpostazioniPage"
             NavigationPage.HasNavigationBar="False">
    <Border Stroke="Black" StrokeThickness="3" BackgroundColor="White">
        <Grid RowDefinitions="Auto,*,Auto" Padding="30,20,30,15">
            <Label Text="⚙️ IMPOSTAZIONI" Style="{StaticResource TitoloDialog}" Margin="0,0,0,10" />

            <ScrollView Grid.Row="1">
                <Grid ColumnDefinitions="*,20,*">

                    <!-- ═══ REGISTRATORE TELEMATICO ═══ -->
                    <VerticalStackLayout>
                        <Label Text="🧾 REGISTRATORE TELEMATICO" Style="{StaticResource Sezione}" Margin="0,0,0,4" />
                        <Label Text="Tipo" Style="{StaticResource Campo}" />
                        <Picker x:Name="SceltaTipo" SelectedIndexChanged="OnTipoCambiato">
                            <Picker.Items>
                                <x:String>3i (XON/XOFF)</x:String>
                                <x:String>Epson</x:String>
                            </Picker.Items>
                        </Picker>
                        <Grid ColumnDefinitions="2*,*" ColumnSpacing="12">
                            <VerticalStackLayout>
                                <Label Text="Indirizzo IP" Style="{StaticResource Campo}" />
                                <Entry x:Name="CampoIP" Keyboard="Url" Placeholder="192.168.1.100" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Porta" Style="{StaticResource Campo}" />
                                <Entry x:Name="CampoPorta" Keyboard="Numeric" />
                            </VerticalStackLayout>
                        </Grid>
                        <Label Text="Operatore RT" Style="{StaticResource Campo}" />
                        <Entry x:Name="CampoOperatore" Keyboard="Numeric" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout>
                                <Label Text="Timeout connessione (ms)" Style="{StaticResource Campo}" />
                                <Entry x:Name="CampoTimeoutConn" Keyboard="Numeric" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Timeout risposta (ms)" Style="{StaticResource Campo}" />
                                <Entry x:Name="CampoTimeoutRisp" Keyboard="Numeric" />
                            </VerticalStackLayout>
                        </Grid>
                        <Button Text="🔌 PROVA CONNESSIONE" BackgroundColor="#2196F3" HeightRequest="54" Margin="0,14,0,0" Clicked="OnProva" />
                    </VerticalStackLayout>

                    <!-- ═══ VENDITA / CATALOGO / SISTEMA ═══ -->
                    <VerticalStackLayout Grid.Column="2">
                        <Label Text="🛒 VENDITA" Style="{StaticResource Sezione}" Margin="0,0,0,4" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Accorpa righe uguali sullo scontrino" FontSize="15" VerticalOptions="Center" />
                            <Switch x:Name="SwAccorpa" Grid.Column="1" OnColor="#4CAF50" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Apri cassetto dopo lo scontrino" FontSize="15" VerticalOptions="Center" />
                            <Switch x:Name="SwCassetto" Grid.Column="1" OnColor="#4CAF50" />
                        </Grid>
                        <Label Text="Tasti reparto nella barra in basso" Style="{StaticResource Campo}" />
                        <Entry x:Name="CampoTastiReparto" Placeholder="1=BAR;2=PASTICCERIA;3=VARIE" />
                        <Label Text="Formato numero=nome, separati da punto e virgola." FontSize="12" TextColor="#666666" />
                        <Label Text="PIN per Strumenti e modalità modifica (vuoto = nessuno)" Style="{StaticResource Campo}" />
                        <Entry x:Name="CampoPin" Keyboard="Numeric" IsPassword="True" MaxLength="8" />

                        <Label Text="📦 CATALOGO" Style="{StaticResource Sezione}" />
                        <Label x:Name="InfoCatalogo" FontSize="14" TextColor="#666666" />
                        <Label Text="Per riprendere gli articoli del PC: chiudere POS Touch, copiare pos.db sul tablet e sceglierlo qui."
                               FontSize="12" TextColor="#666666" />
                        <Button Text="📥 IMPORTA CATALOGO (pos.db)" BackgroundColor="#37474F" HeightRequest="54" Margin="0,8,0,0" Clicked="OnImportaCatalogo" />

                        <Label Text="ℹ️ SISTEMA" Style="{StaticResource Sezione}" />
                        <Label x:Name="InfoVersione" FontSize="14" TextColor="#666666" />
                        <Button Text="📤 CONDIVIDI LOG" BackgroundColor="#607D8B" HeightRequest="54" Margin="0,8,0,0" Clicked="OnCondividiLog" />
                    </VerticalStackLayout>
                </Grid>
            </ScrollView>

            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,15,0,0">
                <Button Text="✖ ANNULLA" Style="{StaticResource TastoAnnulla}" Clicked="OnAnnulla" />
                <Button Grid.Column="1" Text="✔ SALVA" Style="{StaticResource TastoSalva}" Clicked="OnSalva" />
            </Grid>
        </Grid>
    </Border>
</ContentPage>
