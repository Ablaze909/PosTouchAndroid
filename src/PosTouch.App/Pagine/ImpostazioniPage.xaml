<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PosTouch.App.Pagine.ImpostazioniPage"
             Title="Impostazioni">
    <ScrollView>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="24" Padding="20">

            <!-- ═══ COLONNA SINISTRA: registratore ═══ -->
            <VerticalStackLayout Spacing="6">
                <Label Text="REGISTRATORE TELEMATICO" Style="{StaticResource Sezione}" />
                <Label Text="Tipo" />
                <Picker x:Name="SceltaTipo" SelectedIndexChanged="OnTipoCambiato">
                    <Picker.Items>
                        <x:String>3i (XON/XOFF)</x:String>
                        <x:String>Epson</x:String>
                    </Picker.Items>
                </Picker>
                <Label Text="Indirizzo IP" />
                <Entry x:Name="CampoIP" Keyboard="Url" Placeholder="192.168.1.100" />
                <Label Text="Porta" />
                <Entry x:Name="CampoPorta" Keyboard="Numeric" />
                <Label Text="Operatore RT" />
                <Entry x:Name="CampoOperatore" Keyboard="Numeric" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout>
                        <Label Text="Timeout connessione (ms)" />
                        <Entry x:Name="CampoTimeoutConn" Keyboard="Numeric" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Timeout risposta (ms)" />
                        <Entry x:Name="CampoTimeoutRisp" Keyboard="Numeric" />
                    </VerticalStackLayout>
                </Grid>
                <Button Text="PROVA CONNESSIONE" Clicked="OnProva" Margin="0,8,0,0" />
            </VerticalStackLayout>

            <!-- ═══ COLONNA DESTRA: vendita, catalogo, sistema ═══ -->
            <VerticalStackLayout Grid.Column="1" Spacing="6">
                <Label Text="VENDITA" Style="{StaticResource Sezione}" />
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Accorpa righe uguali sullo scontrino" VerticalOptions="Center" />
                    <Switch x:Name="SwAccorpa" Grid.Column="1" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Apri cassetto dopo lo scontrino" VerticalOptions="Center" />
                    <Switch x:Name="SwCassetto" Grid.Column="1" />
                </Grid>
                <Label Text="PIN impostazioni (vuoto = nessuno)" />
                <Entry x:Name="CampoPin" Keyboard="Numeric" IsPassword="True" MaxLength="8" />

                <Label Text="CATALOGO PRODOTTI" Style="{StaticResource Sezione}" />
                <Label x:Name="InfoCatalogo" TextColor="{StaticResource TestoTenue}" />
                <Label Text="Copiare dal PC il file pos.db (con POS Touch chiuso) e sceglierlo qui."
                       FontSize="12" TextColor="{StaticResource TestoTenue}" />
                <Button Text="IMPORTA CATALOGO (pos.db)" Clicked="OnImportaCatalogo" />

                <Label Text="SISTEMA" Style="{StaticResource Sezione}" />
                <Label x:Name="InfoVersione" TextColor="{StaticResource TestoTenue}" />
                <Button Text="CONDIVIDI LOG" Clicked="OnCondividiLog" />

                <Button Text="SALVA" Clicked="OnSalva" BackgroundColor="{StaticResource Contanti}"
                        HeightRequest="60" FontSize="18" Margin="0,20,0,0" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
