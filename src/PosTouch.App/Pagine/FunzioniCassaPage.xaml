<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PosTouch.App.Pagine.FunzioniCassaPage"
             Title="Funzioni cassa">
    <Grid>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="24" Padding="20">

            <VerticalStackLayout Spacing="10">
                <Label Text="REGISTRATORE" Style="{StaticResource Sezione}" />
                <Button Text="LETTURA GIORNALIERA" Clicked="OnLettura" HeightRequest="60" />
                <Button Text="RISTAMPA ULTIMO SCONTRINO" Clicked="OnRistampa" HeightRequest="60" />
                <Button Text="APRI CASSETTO" Clicked="OnCassetto" HeightRequest="60" />
                <Button Text="SBLOCCA RT (annulla scontrino aperto)" Clicked="OnSblocca" HeightRequest="60" />
                <Button Text="CHIUSURA FISCALE (Z)" Clicked="OnChiusura" HeightRequest="70"
                        BackgroundColor="{StaticResource Pericolo}" Margin="0,16,0,0" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1" Spacing="6">
                <Label Text="INCASSI DI OGGI (questo dispositivo)" Style="{StaticResource Sezione}" />
                <Border BackgroundColor="{StaticResource Pannello}" StrokeThickness="0" Padding="16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                        <Label Text="Scontrini" FontSize="18" />
                        <Label x:Name="TotScontrini" Grid.Column="1" FontSize="18" FontAttributes="Bold" />
                        <Label Grid.Row="1" Text="Contanti" FontSize="18" />
                        <Label x:Name="TotContanti" Grid.Row="1" Grid.Column="1" FontSize="18" FontAttributes="Bold" />
                        <Label Grid.Row="2" Text="Carta" FontSize="18" />
                        <Label x:Name="TotCarta" Grid.Row="2" Grid.Column="1" FontSize="18" FontAttributes="Bold" />
                        <Label Grid.Row="3" Text="TOTALE" FontSize="22" FontAttributes="Bold" />
                        <Label x:Name="TotTotale" Grid.Row="3" Grid.Column="1" FontSize="22" FontAttributes="Bold"
                               TextColor="{StaticResource Primario}" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </Grid>

        <Grid x:Name="Attesa" IsVisible="False" BackgroundColor="#99000000">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="True" Color="White" WidthRequest="60" HeightRequest="60" />
                <Label Text="Operazione in corso..." TextColor="White" FontSize="20" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
