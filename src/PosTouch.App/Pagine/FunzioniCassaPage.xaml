<?xml version="1.0" encoding="utf-8" ?>
<!-- Copia di FunzioniCassaDialog del PC (500×600, sfondo #ECEFF1) -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PosTouch.App.Pagine.FunzioniCassaPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#99000000">
    <Grid>
        <Border x:Name="Riquadro" WidthRequest="500" HeightRequest="680" HorizontalOptions="Center" VerticalOptions="Center"
                BackgroundColor="#ECEFF1" StrokeThickness="0">
            <Grid RowDefinitions="Auto,*,Auto" Padding="20">
                <Label Text="FUNZIONI FISCALI E GESTIONE CASSA" FontSize="20" FontAttributes="Bold" TextColor="#37474F"
                       HorizontalOptions="Center" Margin="0,0,0,20" />
                <ScrollView Grid.Row="1">
                    <VerticalStackLayout>
                        <Label Text="📊 RAPPORTI FISCALI" FontSize="16" FontAttributes="Bold" TextColor="#37474F" Margin="10,0,0,10" />
                        <Button Text="✅ CHIUSURA FISCALE (Z)" Style="{StaticResource TastoFunzione}" BackgroundColor="#4CAF50" Margin="10" Clicked="OnChiusura" />
                        <Button Text="📋 LETTURA GIORNALIERA (X)" Style="{StaticResource TastoFunzione}" Margin="10" Clicked="OnLettura" />
                        <Button Text="📊 RAPPORTO REPARTI (Lettura)" Style="{StaticResource TastoFunzione}" Margin="10" Clicked="OnRapportoReparti" />

                        <Label Text="🖨️ RISTAMPE" FontSize="16" FontAttributes="Bold" TextColor="#37474F" Margin="10,20,0,10" />
                        <Button Text="📄 ULTIMO SCONTRINO" Style="{StaticResource TastoFunzione}" Margin="10" Clicked="OnRistampa" />
                        <Button Text="📄 PENULTIMO SCONTRINO" Style="{StaticResource TastoFunzione}" Margin="10" Clicked="OnRistampaPenultimo" />

                        <Label Text="🔧 MANUTENZIONE RT" FontSize="16" FontAttributes="Bold" TextColor="#37474F" Margin="10,20,0,10" />
                        <Button Text="🔄 RESET RT (Sblocca scontrino aperto)" Style="{StaticResource TastoFunzione}" BackgroundColor="#F44336" Margin="10" Clicked="OnSblocca" />
                    </VerticalStackLayout>
                </ScrollView>
                <Button Grid.Row="2" Text="CHIUDI" Style="{StaticResource TastoFunzione}" BackgroundColor="#607D8B" Margin="10,20,10,0" Clicked="OnChiudi" />
            </Grid>
        </Border>

        <Grid x:Name="Attesa" IsVisible="False" BackgroundColor="#99000000">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="True" Color="White" WidthRequest="60" HeightRequest="60" />
                <Label Text="⏳ Operazione in corso..." TextColor="White" FontSize="20" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
