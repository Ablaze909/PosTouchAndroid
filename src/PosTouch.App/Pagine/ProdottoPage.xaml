<?xml version="1.0" encoding="utf-8" ?>
<!-- Copia di ProdottoDialogTouch del PC (a tutto schermo, bordo nero 3px, form a 3 colonne) -->
<ctl:PaginaPos xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctl="clr-namespace:PosTouch.App.Controlli"
             x:Class="PosTouch.App.Pagine.ProdottoPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="White">
    <ctl:PaginaPos.Resources>
        <Style x:Key="Etichetta" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="#1A1A1A" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="Campo" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#F5F5F5" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 4" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="TastoScelta" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#F5F5F5" />
            <Setter Property="TextColor" Value="#333333" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="BorderColor" Value="#E0E0E0" />
            <Setter Property="BorderWidth" Value="2" />
            <Setter Property="Padding" Value="2,0" />
        </Style>
    </ctl:PaginaPos.Resources>

    <Border Stroke="Black" StrokeThickness="3" BackgroundColor="White">
        <Grid RowDefinitions="Auto,*,Auto" Padding="30,20,30,15">
            <!-- titolo + ATTIVO -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,15">
                <Label x:Name="Titolo" Text="➕ NUOVO PRODOTTO" FontSize="26" FontAttributes="Bold" TextColor="Black" />
                <HorizontalStackLayout x:Name="PannelloAttivo" Grid.Column="1" VerticalOptions="Center" Spacing="8" IsVisible="False">
                    <Label x:Name="TestoAttivo" Text="ATTIVO" FontSize="13" FontAttributes="Bold" TextColor="#4CAF50" VerticalOptions="Center" />
                    <Switch x:Name="SwAttivo" OnColor="#4CAF50" Toggled="OnAttivoCambiato" />
                </HorizontalStackLayout>
            </Grid>

            <ScrollView Grid.Row="1">
                <Grid ColumnDefinitions="*,20,*,20,280">
                    <!-- ═══ COLONNA 1: dati principali ═══ -->
                    <VerticalStackLayout>
                        <Label Text="Descrizione *" Style="{StaticResource Etichetta}" />
                        <Border Style="{StaticResource Campo}">
                            <Entry x:Name="CampoDescrizione" FontSize="16" MaxLength="38" TextTransform="Uppercase" BackgroundColor="Transparent" TextChanged="OnAnteprima" />
                        </Border>
                        <Grid ColumnDefinitions="*,12,*">
                            <VerticalStackLayout>
                                <Label Text="Prezzo vendita (€) *" Style="{StaticResource Etichetta}" />
                                <Border Style="{StaticResource Campo}">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPrezzo" /></Border.GestureRecognizers>
                                    <Label x:Name="TestoPrezzo" Text="Tocca per digitare" FontSize="16" TextColor="#BDBDBD" VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2">
                                <Label Text="Costo acquisto (€)" Style="{StaticResource Etichetta}" />
                                <Border Style="{StaticResource Campo}">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCosto" /></Border.GestureRecognizers>
                                    <Label x:Name="TestoCosto" Text="Per margini" FontSize="16" TextColor="#BDBDBD" VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                        <Label x:Name="TestoMargine" Text="💎 Margine: -- €" FontSize="14" FontAttributes="Bold" TextColor="#2E7D32" Margin="0,0,0,12" />

                        <!-- listini 2-4 (come il PC): vuoto = stesso prezzo del listino 1; ogni sala sceglie il suo listino -->
                        <Label Text="Prezzi listini 2 · 3 · 4 (vuoto = come il listino 1)" Style="{StaticResource Etichetta}" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,0,0,12">
                            <Border Style="{StaticResource Campo}">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnListino2" /></Border.GestureRecognizers>
                                <Label x:Name="TestoListino2" FontSize="15" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Campo}">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnListino3" /></Border.GestureRecognizers>
                                <Label x:Name="TestoListino3" FontSize="15" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Campo}">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnListino4" /></Border.GestureRecognizers>
                                <Label x:Name="TestoListino4" FontSize="15" VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <Label Text="Barcode / EAN (opzionale, lettere e cifre)" Style="{StaticResource Etichetta}" />
                        <Grid ColumnDefinitions="*,6,50">
                            <Border Style="{StaticResource Campo}">
                                <!-- testo libero: i CODE39/128 hanno lettere; niente correttore/suggerimenti -->
                                <Entry x:Name="CampoBarcode" FontSize="16" Keyboard="Plain" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                                       MaxLength="48" BackgroundColor="Transparent" />
                            </Border>
                            <Button Grid.Column="2" Text="🔢" FontSize="20" BackgroundColor="#2196F3" CornerRadius="4" HeightRequest="44" VerticalOptions="Start" Clicked="OnTastieraBarcode" />
                        </Grid>

                        <!-- altri barcode dello stesso articolo (confezioni): ognuno vale N pezzi -->
                        <Label Text="Altri barcode / confezioni" Style="{StaticResource Etichetta}" />
                        <VerticalStackLayout x:Name="ListaBarcodeAggiuntivi" Spacing="4" />
                        <Button Text="➕ AGGIUNGI BARCODE (confezione)" FontSize="14" FontAttributes="Bold" BackgroundColor="#455A64" TextColor="White"
                                CornerRadius="4" HeightRequest="44" Margin="0,4,0,0" Clicked="OnAggiungiBarcode" />

                        <!-- ═══ TIPO ARTICOLO: peso / codice bilancia / combinazione (come il PC) ═══ -->
                        <Label Text="Tipo articolo" Style="{StaticResource Etichetta}" />
                        <!-- HeightRequest -1: lo stile Campo fissa 44 e tagliava tutto sotto i tasti (opzioni invisibili) -->
                        <Border Style="{StaticResource Campo}" Padding="10,6" HeightRequest="-1">
                            <VerticalStackLayout Spacing="2">
                                <!-- un solo tipo per articolo: tasti grandi che si accendono -->
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6" Margin="0,2,0,6">
                                    <Button x:Name="BtnTipoStandard" Grid.Column="0" Text="📦&#10;STANDARD" FontSize="12" LineBreakMode="WordWrap" FontAttributes="Bold" HeightRequest="58" CornerRadius="6" Padding="2,0" Clicked="OnTipoStandard" />
                                    <Button x:Name="BtnTipoCoperto" Grid.Column="1" Text="🍽️&#10;COPERTO" FontSize="12" LineBreakMode="WordWrap" FontAttributes="Bold" HeightRequest="58" CornerRadius="6" Padding="2,0" Clicked="OnTipoCoperto" />
                                    <Button x:Name="BtnTipoPeso" Grid.Column="2" Text="⚖️&#10;A PESO" FontSize="12" LineBreakMode="WordWrap" FontAttributes="Bold" HeightRequest="58" CornerRadius="6" Padding="2,0" Clicked="OnTipoPeso" />
                                    <Button x:Name="BtnTipoCombinazione" Grid.Column="3" Text="🍕&#10;COMBINAZ." FontSize="12" LineBreakMode="WordWrap" FontAttributes="Bold" HeightRequest="58" CornerRadius="6" Padding="2,0" Clicked="OnTipoCombinazione" />
                                </Grid>
                                <Label x:Name="AiutoTipo" FontSize="12" TextColor="#78909C" Margin="2,0,0,4" />
                                <!-- opzioni del tipo (peso / combinazione): riepilogo sempre visibile + tasto che apre la scelta -->
                                <Grid x:Name="RigaOpzioniTipo" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                                    <Label x:Name="RiepilogoTipo" FontSize="15" FontAttributes="Bold" TextColor="#E65100" VerticalOptions="Center" LineBreakMode="WordWrap" />
                                    <Button x:Name="BtnOpzioniTipo" Grid.Column="1" Text="⚙️ OPZIONI" FontSize="13" FontAttributes="Bold" BackgroundColor="#E65100" TextColor="White"
                                            HeightRequest="44" CornerRadius="6" Padding="12,0" Clicked="OnOpzioniTipo" />
                                </Grid>
                                <Grid x:Name="PannelloPeso" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="34,0,0,4" IsVisible="False">
                                    <Label Text="Prezzo al:" FontSize="14" VerticalOptions="Center" />
                                    <ctl:CampoScelta x:Name="SceltaUnita" Grid.Column="1" FontSize="15" Titolo="Unità di peso" Colonne="3" />
                                </Grid>
                                <HorizontalStackLayout>
                                    <CheckBox x:Name="ChkBilancia" Color="#4CAF50" />
                                    <Label Text="🏷️ Codice bilancia (barcode = 5 cifre dell'etichetta)" FontSize="15" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Grid x:Name="PannelloCombinazione" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6" Margin="34,0,0,4" IsVisible="False">
                                    <Label Text="Gusti:" FontSize="14" VerticalOptions="Center" />
                                    <ctl:CampoScelta x:Name="SceltaGusti" Grid.Column="1" FontSize="15" Titolo="Numero di gusti" Colonne="5" />
                                    <Label Grid.Row="1" Text="Prezzo:" FontSize="14" VerticalOptions="Center" />
                                    <ctl:CampoScelta x:Name="SceltaPolitica" Grid.Row="1" Grid.Column="1" FontSize="15" Titolo="Prezzo della combinazione" Colonne="1" />
                                    <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2">
                                        <CheckBox x:Name="ChkProporzionali" Color="#4CAF50" />
                                        <Label Text="Varianti proporzionali (prezzo diviso per i gusti)" FontSize="14" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- ═══ COLONNA 2: categoria e aspetto ═══ -->
                    <VerticalStackLayout Grid.Column="2">
                        <Label Text="Categoria *" Style="{StaticResource Etichetta}" />
                        <Border Style="{StaticResource Campo}">
                            <ctl:CampoScelta x:Name="SceltaCategoria" FontSize="16" Titolo="Categoria" />
                        </Border>

                        <Label Text="🍽️ Comande (uscita di stampa)" Style="{StaticResource Etichetta}" />
                        <Border Style="{StaticResource Campo}">
                            <ctl:CampoScelta x:Name="SceltaCentro" FontSize="16" Titolo="Uscita di stampa" Colonne="2" />
                        </Border>

                        <Label Text="Colore bottone" Style="{StaticResource Etichetta}" />
                        <Grid ColumnDefinitions="*,8,60" Margin="0,0,0,12">
                            <Border Style="{StaticResource Campo}" Margin="0">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnColore" /></Border.GestureRecognizers>
                                <Label x:Name="TestoColore" FontSize="16" VerticalOptions="Center" />
                            </Border>
                            <Border x:Name="AnteprimaColore" Grid.Column="2" StrokeThickness="1" Stroke="#E0E0E0" StrokeShape="RoundRectangle 4">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnColore" /></Border.GestureRecognizers>
                            </Border>
                        </Grid>

                        <Label Text="Colore testo tasto" Style="{StaticResource Etichetta}" />
                        <Grid ColumnDefinitions="*,6,*,6,*,6,*" Margin="0,0,0,12">
                            <Button x:Name="BtnBianco" Text="⬜ Bianco" Style="{StaticResource TastoScelta}" Clicked="OnColoreTestoBianco" />
                            <Button x:Name="BtnNero" Grid.Column="2" Text="⬛ Nero" Style="{StaticResource TastoScelta}" Clicked="OnColoreTestoNero" />
                            <Button x:Name="BtnGiallo" Grid.Column="4" Text="🟡 Giallo" Style="{StaticResource TastoScelta}" Clicked="OnColoreTestoGiallo" />
                            <Button x:Name="BtnAltro" Grid.Column="6" Text="🎨 Altro" Style="{StaticResource TastoScelta}" Clicked="OnColoreTestoAltro" />
                        </Grid>

                        <Label Text="Dimensione testo tasto" Style="{StaticResource Etichetta}" />
                        <Grid ColumnDefinitions="*,6,*,6,*,6,*" Margin="0,0,0,12">
                            <Button x:Name="BtnFont10" Text="A  Piccolo" FontSize="10" Style="{StaticResource TastoScelta}" HeightRequest="54" Clicked="OnFont10" />
                            <Button x:Name="BtnFont12" Grid.Column="2" Text="A  Medio" FontSize="13" Style="{StaticResource TastoScelta}" HeightRequest="54" Clicked="OnFont12" />
                            <Button x:Name="BtnFont14" Grid.Column="4" Text="A  Grande" FontSize="16" Style="{StaticResource TastoScelta}" HeightRequest="54" Clicked="OnFont14" />
                            <Button x:Name="BtnFont16" Grid.Column="6" Text="A  XL" FontSize="19" Style="{StaticResource TastoScelta}" HeightRequest="54" Clicked="OnFont16" />
                        </Grid>

                        <HorizontalStackLayout Spacing="6">
                            <CheckBox x:Name="ChkPreferito" Color="#FF9800" CheckedChanged="OnAnteprima" />
                            <Label Text="⭐ Aggiungi ai preferiti" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- ═══ COLONNA 3: anteprima ═══ -->
                    <VerticalStackLayout Grid.Column="4">
                        <Label Text="Anteprima Tasto POS" FontSize="12" TextColor="#757575" Margin="0,0,0,4" />
                        <Border x:Name="Anteprima" WidthRequest="100" HeightRequest="100" StrokeThickness="0" HorizontalOptions="Start">
                            <Grid RowDefinitions="*,Auto">
                                <Label x:Name="AnteprimaNome" Text="PRODOTTO" FontSize="12" FontAttributes="Bold" LineBreakMode="WordWrap"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" Margin="4" />
                                <Grid Grid.Row="1" BackgroundColor="#40000000" Padding="4,2">
                                    <Label x:Name="AnteprimaPrezzo" Text="€ 0,00" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>
                        <Label Text="Così apparirà&#10;nel POS cassa" FontSize="11" TextColor="#999999" Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </Grid>
            </ScrollView>

            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,140,10,140" Margin="0,15,0,0">
                <Button x:Name="BtnElimina" Text="🗑️ ELIMINA" WidthRequest="140" HeightRequest="50" FontSize="16" BackgroundColor="#F44336"
                        CornerRadius="8" IsVisible="False" Clicked="OnElimina" />
                <Button Grid.Column="2" Text="❌ ANNULLA" HeightRequest="50" FontSize="16" BackgroundColor="#9E9E9E" CornerRadius="8" Clicked="OnAnnulla" />
                <Button Grid.Column="4" Text="✓ SALVA" HeightRequest="50" FontSize="16" BackgroundColor="#4CAF50" CornerRadius="8" Clicked="OnSalva" />
            </Grid>
        </Grid>
    </Border>
</ctl:PaginaPos>
