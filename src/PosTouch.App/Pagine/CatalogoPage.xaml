<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:PosTouch.Core.Modelli;assembly=PosTouch.Core"
             xmlns:conv="clr-namespace:PosTouch.App.Convertitori"
             x:Class="PosTouch.App.Pagine.CatalogoPage"
             Title="Categorie e articoli">
    <ContentPage.Resources>
        <conv:ColoreConverter x:Key="Colore" />
    </ContentPage.Resources>

    <Grid ColumnDefinitions="320,*" ColumnSpacing="12" Padding="12">

        <!-- ═══ CATEGORIE (reparti) ═══ -->
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
            <Label Text="CATEGORIE / REPARTI" Style="{StaticResource Sezione}" Margin="0" />
            <CollectionView x:Name="ListaCategorie" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnCategoriaScelta">
                <CollectionView.EmptyView>
                    <Label Text="Nessuna categoria.&#10;Crea la prima con il tasto qui sotto."
                           HorizontalTextAlignment="Center" VerticalOptions="Center" TextColor="{StaticResource TestoTenue}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:Categoria">
                        <Grid ColumnDefinitions="10,*,Auto" ColumnSpacing="10" Padding="6,12" BackgroundColor="{StaticResource Pannello}">
                            <BoxView Color="{Binding Colore, Converter={StaticResource Colore}}" />
                            <Label Grid.Column="1" Text="{Binding Nome}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="2" FontSize="13" TextColor="{StaticResource TestoTenue}" VerticalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Rep. " />
                                        <Span Text="{Binding RepartoFiscale}" />
                                        <Span Text=" · IVA " />
                                        <Span Text="{Binding AliquotaIVA}" />
                                        <Span Text="%" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="6">
                <Button Text="+ CATEGORIA" Clicked="OnNuovaCategoria" BackgroundColor="{StaticResource Primario}" />
                <Button Grid.Column="1" Text="MODIFICA" Clicked="OnModificaCategoria" />
            </Grid>
        </Grid>

        <!-- ═══ ARTICOLI della categoria scelta ═══ -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="8">
            <Label x:Name="TitoloArticoli" Text="ARTICOLI" Style="{StaticResource Sezione}" Margin="0" />
            <CollectionView x:Name="ListaArticoli" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnArticoloScelto">
                <CollectionView.EmptyView>
                    <Label x:Name="VuotoArticoli" Text="Scegli una categoria"
                           HorizontalTextAlignment="Center" VerticalOptions="Center" TextColor="{StaticResource TestoTenue}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:Prodotto">
                        <Grid ColumnDefinitions="10,*,Auto,Auto" ColumnSpacing="10" Padding="6,12" BackgroundColor="{StaticResource Pannello}">
                            <BoxView Color="{Binding Colore, Converter={StaticResource Colore}, ConverterParameter='#455A64'}" />
                            <Label Grid.Column="1" Text="{Binding Descrizione}" FontSize="16" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="{Binding Barcode}" FontSize="12" TextColor="{StaticResource TestoTenue}" VerticalOptions="Center" />
                            <Label Grid.Column="3" Text="{Binding PrezzoEuro, StringFormat='€ {0:N2}'}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button Grid.Row="2" x:Name="BtnNuovoArticolo" Text="+ ARTICOLO" Clicked="OnNuovoArticolo"
                    BackgroundColor="{StaticResource Primario}" IsEnabled="False" HorizontalOptions="Start" WidthRequest="220" />
        </Grid>
    </Grid>
</ContentPage>
