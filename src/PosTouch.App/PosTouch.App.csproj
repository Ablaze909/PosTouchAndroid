<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>PosTouch.App</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <!-- Identità app -->
    <ApplicationTitle>POS Touch</ApplicationTitle>
    <ApplicationId>it.alfacash.postouch</ApplicationId>
    <ApplicationDisplayVersion>0.17.3</ApplicationDisplayVersion>
    <!-- La build su GitHub lo sostituisce col numero di build, così ogni APK si installa sopra il precedente -->
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Android 7.0+ (Android 11 incluso) -->
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <!-- Firma sempre con la stessa chiave: gli aggiornamenti si installano senza disinstallare -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(MSBuildThisFileDirectory)..\..\keystore\postouch.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>postouch</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>env:POSTOUCH_KEY_PASS</AndroidSigningKeyPass>
    <AndroidSigningStorePass>env:POSTOUCH_KEY_PASS</AndroidSigningStorePass>

    <!-- velocità: tutto il codice compilato in anticipo (non solo l'avvio), così ogni schermata risponde subito.
         Solo tablet ARM (64 e 32 bit: alcuni tablet economici hanno Android a 32 bit); tolti gli emulatori x86/x64
         che non servono e appesantivano l'APK -->
    <RuntimeIdentifiers>android-arm64;android-arm</RuntimeIdentifiers>
    <RunAOTCompilation>true</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1E3A5F" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1E3A5F" BaseSize="128,128" />
    <!-- file dentro l'app (es. catalogo_prova.db per i dati di prova) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- icone a linee dei temi Scuro/Chiaro (Material Design Icons, licenza in /licenze) -->
    <MauiFont Include="Resources\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PosTouch.Core\PosTouch.Core.csproj" />
  </ItemGroup>

</Project>
