<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PosTouch.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Colori (stessa palette sobria della versione Windows) -->
            <Color x:Key="Sfondo">#F2F4F7</Color>
            <Color x:Key="Pannello">#FFFFFF</Color>
            <Color x:Key="Primario">#1E3A5F</Color>
            <Color x:Key="Testo">#1A1A1A</Color>
            <Color x:Key="TestoTenue">#6B7280</Color>
            <Color x:Key="Contanti">#2E7D32</Color>
            <Color x:Key="Carta">#1565C0</Color>
            <Color x:Key="Misto">#6A1B9A</Color>
            <Color x:Key="Neutro">#546E7A</Color>
            <Color x:Key="Pericolo">#C62828</Color>

            <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="{StaticResource Sfondo}" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Testo}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BackgroundColor" Value="{StaticResource Neutro}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="MinimumHeightRequest" Value="48" />
            </Style>
            <Style x:Key="Sezione" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource TestoTenue}" />
                <Setter Property="Margin" Value="0,12,0,4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
