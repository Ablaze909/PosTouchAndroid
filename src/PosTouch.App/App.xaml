<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PosTouch.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Palette di POS Touch Windows -->
            <Color x:Key="Sfondo">#FFFFFF</Color>
            <Color x:Key="SfondoDialog">#ECEFF1</Color>
            <Color x:Key="Pannello">#FFFFFF</Color>
            <Color x:Key="Grigio">#FAFAFA</Color>
            <Color x:Key="Bordo">#E5E5E5</Color>
            <Color x:Key="Primario">#37474F</Color>
            <Color x:Key="Testo">#111111</Color>
            <Color x:Key="TestoTenue">#666666</Color>
            <Color x:Key="Verde">#4CAF50</Color>
            <Color x:Key="VerdeScuro">#388E3C</Color>
            <Color x:Key="Blu">#2196F3</Color>
            <Color x:Key="BluScuro">#1976D2</Color>
            <Color x:Key="Rosso">#F44336</Color>
            <Color x:Key="Arancio">#FF9800</Color>
            <Color x:Key="Neutro">#555555</Color>
            <Color x:Key="Chiudi">#607D8B</Color>
            <!-- nomi usati dalle pagine -->
            <Color x:Key="Contanti">#4CAF50</Color>
            <Color x:Key="Carta">#1976D2</Color>
            <Color x:Key="Misto">#7B1FA2</Color>
            <Color x:Key="Pericolo">#F44336</Color>

            <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="{StaticResource Sfondo}" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Testo}" />
            </Style>
            <!-- Tasti piatti, senza arrotondamenti (stile PC) -->
            <Style TargetType="Button">
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BackgroundColor" Value="{StaticResource Neutro}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="MinimumHeightRequest" Value="44" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.7" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.4" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
            <Style TargetType="Entry">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="TextColor" Value="{StaticResource Testo}" />
                <Setter Property="BackgroundColor" Value="#F5F5F5" />
            </Style>
            <Style TargetType="Picker">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="TextColor" Value="{StaticResource Testo}" />
                <Setter Property="BackgroundColor" Value="#F5F5F5" />
            </Style>

            <!-- Titolo delle finestre (come i dialog del PC) -->
            <Style x:Key="TitoloDialog" TargetType="Label">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="#000000" />
            </Style>
            <!-- Titolo di sezione (es. "📊 RAPPORTI FISCALI") -->
            <Style x:Key="Sezione" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="#37474F" />
                <Setter Property="Margin" Value="0,16,0,6" />
            </Style>
            <!-- Etichetta campo -->
            <Style x:Key="Campo" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="#333333" />
                <Setter Property="Margin" Value="0,8,0,2" />
            </Style>
            <!-- Tasti funzione dei dialog (Funzioni cassa, Strumenti) -->
            <Style x:Key="TastoFunzione" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Blu}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HeightRequest" Value="64" />
                <Setter Property="Margin" Value="0,5" />
            </Style>
            <!-- Tasti conferma/annulla in fondo ai dialog -->
            <Style x:Key="TastoSalva" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Verde}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="HeightRequest" Value="60" />
            </Style>
            <Style x:Key="TastoAnnulla" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#9E9E9E" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="HeightRequest" Value="60" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
